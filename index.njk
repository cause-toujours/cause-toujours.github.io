<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ homepage.meta.title }}</title>
  <meta name="description" content="{{ homepage.meta.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/instagram-feed.css">
  <!-- <link rel="stylesheet" href="css/crossword.css"> -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <!-- === BANDEAU FAMILLE CSS === -->
  <style>
    .fam-tabs {
      width: 100%;
      background: #1A1A1A;
      font-family: 'Oswald', sans-serif;
      border-bottom: 1px solid rgba(250,234,229,0.12);
      line-height: 1;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .fam-tabs-inner { display: flex; width: 100%; }
    .fam-tabs .fam-tab {
      flex: 1; text-align: center; position: relative;
    }
    .fam-tabs .fam-tab a {
      display: block; padding: 16px 24px;
      font-size: 0.85rem; font-weight: 600; letter-spacing: 2px;
      text-transform: uppercase; text-decoration: none;
      color: rgba(250,234,229,0.45);
      transition: color 0.15s, background 0.15s;
    }
    .fam-tabs .fam-tab a:hover {
      color: #FAEAE5; background: rgba(255,255,255,0.05);
    }
    .fam-tabs .fam-tab + .fam-tab::before {
      content: ''; position: absolute;
      left: 0; top: 20%; bottom: 20%;
      width: 1px; background: rgba(250,234,229,0.15);
    }
    .fam-tabs .fam-tab-cc a:hover { color: #EB573F; }
    .fam-tabs .fam-tab-ct a:hover { color: #C8302A; }
    @media (max-width: 480px) {
      .fam-tabs-inner { flex-direction: column; }
      .fam-tabs .fam-tab a { padding: 10px 16px; font-size: 0.7rem; }
      .fam-tabs .fam-tab + .fam-tab::before {
        top: auto; bottom: auto; left: 20%; right: 20%;
        width: auto; height: 1px;
      }
    }
  </style>
</head>
<body>

  <!-- === GRAIN === -->
  <div class="grain"></div>

  <!-- === BANDEAU FAMILLE === -->
  <div class="fam-tabs">
    <div class="fam-tabs-inner">
      <div class="fam-tab fam-tab-cc">
        <a href="https://montpelliercausecommune.org/">Cause Commune</a>
      </div>
      <div class="fam-tab fam-tab-ct">
        <a href="https://cause-toujours.github.io/">Cause Toujours !</a>
      </div>
    </div>
  </div>
  <!-- === / BANDEAU FAMILLE === -->

  <!-- === HEADER === -->
  <header class="hd">
    <div class="hd-inner">
      <a href="#" class="hd-brand">
        <span class="brand-mark">!</span>
        <span class="brand-dateline">Montpellier <span class="sep">·</span> <em>{{ homepage.hero.dateline_date }}</em> <span class="sep">·</span> {{ homepage.hero.dateline_num }}</span>
      </a>
      <nav class="hd-nav">
        <a href="#manifeste">Manifeste</a>
        <a href="#soutenir">Soutenir</a>
        <a href="#numero">Numéro</a>
        <a href="#trouver">Trouver</a>
      </nav>
      <a href="#soutenir" class="btn-hd">S'ABONNER →</a>
    </div>
  </header>

  <!-- === HERO === -->
  <section class="hero" id="hero">
    <div class="kraft-bar">
      {% for item in homepage.hero.kraft_bar %}
      <span>{{ item }}</span>
      {% if not loop.last %}<span class="kraft-dot">●</span>{% endif %}
      {% endfor %}
    </div>

    <div class="hero-grid">
      <div class="hero-left">
        <div class="hero-sticker">{{ homepage.hero.sticker }}</div>
        <h1 class="hero-title-big">{{ homepage.hero.title }}<span class="bang">{{ homepage.hero.title_bang }}</span></h1>
        <p class="hero-subtitle">{{ homepage.hero.subtitle }}</p>
        <p class="hero-baseline">{{ homepage.hero.baseline }}</p>
        <div class="hero-cta">
          <a href="{{ homepage.hero.cta_primary_link }}" class="btn-primary">{{ homepage.hero.cta_primary_text }}</a>
          <a href="{{ homepage.hero.cta_secondary_link }}" class="btn-ghost">{{ homepage.hero.cta_secondary_text }}</a>
        </div>
        <div class="hero-scoll">{{ homepage.hero.scroll_text }}</div>
      </div>

      <div class="hero-right">
        <div class="journal-cover">
          <img src="{{ homepage.hero.cover_image }}" alt="{{ homepage.hero.cover_alt }}">
        </div>
        <div class="hero-badge">
          {% for line in homepage.hero.badge_lines %}
          <span>{{ line }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- === MANIFESTE === -->
  <section class="section" id="manifeste">
    <div class="sec-head">
      <span class="sec-num">{{ homepage.manifeste.section_num }}</span>
      <h2 class="sec-title">{{ homepage.manifeste.section_title_1 }}<br>{{ homepage.manifeste.section_title_2 | safe }}</h2>
      <span class="sec-tag">{{ homepage.manifeste.section_tag }}</span>
    </div>

    <div class="manifeste-layout">
      <div class="manifeste-main">
        <p class="dropcap">{{ homepage.manifeste.dropcap | markdownify }}</p>
        {% for para in homepage.manifeste.paragraphs %}
        <p>{{ para | markdownify }}</p>
        {% endfor %}
      </div>

      <aside class="manifeste-aside">
        <div class="tape tape-accent">
          <span>{{ homepage.manifeste.aside_label }}</span>
        </div>
        <div class="aside-body">
          <p>{{ homepage.manifeste.aside_text }}</p>
          <a href="{{ homepage.manifeste.aside_link_url }}" target="_blank" class="link-block">{{ homepage.manifeste.aside_link_text }}</a>
        </div>
        <div class="manifeste-pull">
          <p><strong>{{ homepage.manifeste.pull_quote | markdownify }}</strong></p>
        </div>
      </aside>
    </div>
  </section>

  <!-- === SOUTENIR === -->
  <section class="section section-alt" id="soutenir">
    <div class="sec-head">
      <span class="sec-num sec-num-light">{{ homepage.soutenir.section_num }}</span>
      <h2 class="sec-title">{{ homepage.soutenir.section_title_1 }}<br>{{ homepage.soutenir.section_title_2 | safe }}</h2>
      <span class="sec-tag sec-tag-light">{{ homepage.soutenir.section_tag }}</span>
    </div>

    <div class="formules">
      {% for formule in homepage.soutenir.formules %}
      <div class="formule{% if formule.highlight %} formule-pick{% endif %}">
        <div class="formule-tape{% if formule.highlight %} formule-tape-accent{% endif %}">{{ formule.tape }}</div>
        <div class="formule-price">{{ formule.price }}<span>{{ formule.price_unit }}</span></div>
        <p class="formule-desc">{{ formule.desc }}</p>
        <a href="{{ formule.button_link }}" class="btn-formule">{{ formule.button_text }}</a>
        {% if formule.flag %}<div class="formule-flag">{{ formule.flag }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>

    <div class="transp">
      <h3 class="transp-title">{{ homepage.soutenir.transparency_title | safe }}</h3>
      <div class="transp-bars">
        {% for bar in homepage.soutenir.transparency_bars %}
        <div class="transp-row">
          <span class="transp-pct">{{ bar.pct }}</span>
          <div class="transp-bar transp-bar-{{ loop.index }}"><span>{{ bar.label }}</span></div>
        </div>
        {% endfor %}
      </div>
      <p class="transp-note">{{ homepage.soutenir.transparency_note | markdownify }}</p>
    </div>

    <div class="adresse-note">
      <span class="aside-label">{{ homepage.soutenir.adresse_label }}</span>
      <p>{{ homepage.soutenir.adresse_text }}</p>
    </div>
  </section>

  <!-- === DERNIER NUMÉRO === -->
  <section class="section" id="numero">
    <div class="sec-head">
      <span class="sec-num">{{ homepage.numero.section_num }}</span>
      <h2 class="sec-title">{{ homepage.numero.section_title_1 }}<br>{{ homepage.numero.section_title_2 }}</h2>
    </div>

    <div class="numero-grid">
      <div class="numero-left">
        <div class="preview-card">
          <div class="preview-tape">{{ homepage.numero.preview_tape }}</div>
          <div class="preview-image">
            <img src="{{ homepage.numero.preview_image }}" alt="{{ homepage.numero.preview_image_alt }}">
          </div>
        </div>
        {% if homepage.numero.section_tag %}
        <p class="preview-caption">{{ homepage.numero.section_tag }}</p>
        {% endif %}
      </div>

      <div class="numero-right">
        <div class="poster-card">
          <div class="poster-head">
            <span class="poster-tape">{{ homepage.numero.poster_tape }}</span>
            <a class="poster-artist-link" href="{{ homepage.numero.poster_artist_url }}" target="_blank" rel="noopener">Artiste&nbsp;: {{ homepage.numero.poster_artist }} <span aria-hidden="true">→</span></a>
          </div>
          <div class="poster-image">
            <img src="{{ homepage.numero.poster_image }}" alt="{{ homepage.numero.poster_image_alt }}">
          </div>
          <p class="poster-caption">{{ homepage.numero.poster_caption }}</p>
        </div>
      </div>
    </div>

    <div class="mini-edito">
      <h3 class="block-title">{{ homepage.numero.mini_edito_label }}</h3>
      <p class="dropcap">{{ homepage.numero.mini_edito_intro | markdownify }}</p>
      {% for para in homepage.numero.mini_edito_paragraphs %}
      <p>{{ para | markdownify }}</p>
      {% endfor %}
      <p class="mini-edito-outro">{{ homepage.numero.mini_edito_outro }}</p>
    </div>

    <div class="numero-duo">
      {% if homepage.numero.crossword_image %}
      <div class="crossword-block">
        <h3 class="block-title">{{ homepage.numero.crossword_title }}</h3>
        <p class="crossword-intro">{{ homepage.numero.crossword_intro }}</p>
        <div class="crossword-reveal">
          <img src="{{ homepage.numero.crossword_image }}" alt="{{ homepage.numero.crossword_image_alt }}" loading="lazy">
          <button class="crossword-overlay" type="button" aria-pressed="false">
            <span class="crossword-btn">{{ homepage.numero.crossword_reveal_text }}</span>
          </button>
        </div>
      </div>
      {% endif %}

      <div class="ig-clip" id="ig-clip" data-override-id="{{ homepage.numero.ig_override_post_id | default('', true) }}">
        <div class="ig-clip-tape">
          <span>{{ homepage.numero.ig_tape_label }}</span>
          <span id="ig-clip-date"></span>
        </div>

        <div class="ig-clip-body">
          <div class="ig-clip-text">
            <p id="ig-post-caption" class="ig-clip-caption"></p>
            <a id="ig-post-link" href="#" target="_blank" rel="noopener noreferrer" class="ig-clip-permalink">
              Voir sur Instagram <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="ig-clip-media">
            <div class="ig-carousel" id="ig-carousel" aria-roledescription="carousel">
              <button class="ig-carousel-nav ig-carousel-prev" id="ig-carousel-prev" type="button" aria-label="Image précédente" hidden>
                <span aria-hidden="true">‹</span>
              </button>
              <div class="ig-carousel-frame">
                <img id="ig-post-image" src="" alt="" loading="lazy" />
              </div>
              <button class="ig-carousel-nav ig-carousel-next" id="ig-carousel-next" type="button" aria-label="Image suivante" hidden>
                <span aria-hidden="true">›</span>
              </button>
              <div class="ig-carousel-counter" id="ig-carousel-counter" hidden></div>
            </div>
          </div>
        </div>

        <p class="ig-clip-intro">{{ homepage.numero.ig_intro }}</p>
      </div>
    </div>
  </section>

  <!-- === OÙ NOUS RETROUVER === -->
  <section class="section section-alt" id="trouver">
    <div class="sec-head">
      <span class="sec-num">{{ homepage.trouver.section_num }}</span>
      <h2 class="sec-title">{{ homepage.trouver.section_title_1 }}<br>{{ homepage.trouver.section_title_2 | safe }}</h2>
      <span class="sec-tag">{{ homepage.trouver.section_tag }}</span>
    </div>

    <div class="trouver-grid">
      <div class="trouver-list">
        {% for loc in homepage.trouver.locations %}
        <div class="trouver-item">
          <span class="trouver-num" style="background:{{ loc.color }}">{{ loc.num }}</span>
          <div>
            <strong>{{ loc.name }}</strong>
            <p>{{ loc.address }}</p>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="trouver-map">
        <div id="map"></div>
      </div>
    </div>
  </section>

  <!-- === QUI SOMMES-NOUS === -->
  <section class="section section-alt" id="qui">
    <div class="sec-head">
      <span class="sec-num sec-num-light">{{ homepage.qui.section_num }}</span>
      <h2 class="sec-title">{{ homepage.qui.section_title_1 }}<br>{{ homepage.qui.section_title_2 | safe }}</h2>
      <span class="sec-tag sec-tag-light">{{ homepage.qui.section_tag }}</span>
    </div>

    <div class="qui-grid">
      <div class="qui-text">
        {% for para in homepage.qui.paragraphs %}
        <p>{{ para | markdownify }}</p>
        {% endfor %}
      </div>

      <div class="qui-right">
        <div class="qui-card">
          <h3 class="block-title-light">{{ homepage.qui.engagement_title }}</h3>
          <p>{{ homepage.qui.engagement_text | markdownify }}</p>
          <a href="mailto:{{ homepage.qui.engagement_email }}?subject=Contribution%20au%20prochain%20num%C3%A9ro&body=Type%20de%20contribution%20%3A%0A%0AMon%20texte%20%3A%0A%0A" class="btn-outline">{{ homepage.qui.engagement_button_text }}</a>
        </div>

        <div class="qui-card">
          <h3 class="block-title-light">{{ homepage.qui.social_title }}</h3>
          <p>{{ homepage.qui.social_text | markdownify }}</p>
          <a href="{{ homepage.qui.social_link_url }}" target="_blank" class="btn-outline">{{ homepage.qui.social_link_text }}</a>
        </div>

      </div>
    </div>

  </section>

  <!-- === FOOTER === -->
  <footer class="ft">
    <div class="ft-inner">
      <div class="ft-main">
        <div class="ft-logo">{{ homepage.footer.logo }}<span class="bang">{{ homepage.footer.logo_bang }}</span></div>
        <p class="ft-text">{{ homepage.footer.text }}</p>
        <div class="ft-bar">
          {% for item in homepage.footer.bar_items %}
          <span>{{ item }}</span>
          {% if not loop.last %}<span class="ft-dot">●</span>{% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="ft-cc">
        <img src="{{ homepage.footer.cc_logo }}" alt="{{ homepage.footer.cc_logo_alt }}">
        <div class="ft-cc-text">
          <span class="ft-cc-label">{{ homepage.qui.cc_label }}</span>
          <strong>{{ homepage.qui.cc_name }}</strong>
          <span class="ft-cc-detail">{{ homepage.qui.cc_detail }}</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- === INSTAGRAM FEED === -->
  <script src="js/instagram-feed.js" defer></script>
  <script src="js/crossword-reveal.js" defer></script>
  <!-- crossword.js — commenté pour le N°001, réactivé pour les prochains numéros -->
  <!-- <script src="js/crossword.js" defer></script> -->

  <!-- === LEAFLET MAP === -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const map = L.map('map', { scrollWheelZoom: false });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    }).addTo(map);
    const bounds = [];
    {% for loc in homepage.trouver.locations %}
    bounds.push([{{ loc.lat }}, {{ loc.lng }}]);
    L.marker([{{ loc.lat }}, {{ loc.lng }}], {
      icon: L.divIcon({
        className: 'ct-marker',
        html: '<div style="background:{{ loc.color }}" class="ct-marker-inner">{{ loc.num }}</div>',
        iconSize: [36, 36],
        iconAnchor: [18, 18]
      })
    }).addTo(map).bindPopup('<strong>{{ loc.name }}</strong><br>{{ loc.address }}');
    {% endfor %}
    map.fitBounds(bounds, { padding: [30, 30], maxZoom: 16 });
    setTimeout(() => map.invalidateSize(), 100);
  </script>

</body>
</html>
