---
permalink: /manifeste/
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Le manifeste — Cause Toujours !</title>
  <meta name="robots" content="noindex">
  <link rel="canonical" href="https://cause-toujours.org/manifeste/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .mf-header {
      background: var(--noir); color: var(--cream); padding: 18px 24px;
      font-family: var(--font-narrow); display: flex; align-items: center; justify-content: space-between;
      border-bottom: var(--border-4); border-color: var(--rouge);
      position: sticky; top: 0; z-index: 100;
    }
    .mf-header a { color: var(--cream); text-decoration: none; letter-spacing: 1px; }
    .mf-header .mf-logo { font-style: italic; font-weight: 700; text-transform: uppercase; font-size: 1.15rem; }
    .mf-header .mf-back { font-size: 0.75rem; text-transform: uppercase; opacity: 0.85; }
    .mf-header .mf-back:hover { color: var(--rouge-light); }
    .mf-wrapper { max-width: 720px; margin: 0 auto; padding: 72px 24px 96px; }

    .mf-sub { font-family: var(--font-sec); font-style: italic; font-size: 1.05rem; color: var(--noir); margin-top: 14px; }

    .mf-section { margin-bottom: 64px; }
    .mf-section h2 {
      font-family: var(--font-narrow); font-weight: 700; font-style: italic;
      font-size: clamp(1.5rem, 3.6vw, 2.1rem); line-height: 1.05;
      text-transform: uppercase; letter-spacing: -1px;
      border-left: 6px solid var(--rouge); padding-left: 18px; margin-bottom: 24px;
    }
    .mf-section p { font-family: var(--font-body); font-size: 1.13rem; line-height: 1.65; margin-bottom: 20px; }
    .mf-section strong { color: var(--rouge); font-weight: 600; }
    .mf-section em { font-style: italic; }

    .mf-end { margin-top: 64px; text-align: center; }
    .mf-end .mf-sign { font-family: var(--font-narrow); font-style: italic; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
    .mf-footer { border-top: var(--border-4); padding: 32px 24px; text-align: center; }
    .mf-footer a { font-family: var(--font-sec); text-transform: uppercase; font-weight: 500; color: var(--noir); border-bottom: 2px solid var(--noir); padding-bottom: 2px; text-decoration: none; }
    .mf-footer a:hover { color: var(--rouge); border-color: var(--rouge); }
  </style>
</head>
<body>
  <header class="mf-header">
    <a href="/" class="mf-logo">Cause Toujours !</a>
    <a href="/" class="mf-back">← Retour à l'accueil</a>
  </header>

  <section class="section">
    <div class="mf-wrapper">
      <div class="sec-head">
        <span class="sec-num">01</span>
        <div>
          <h1 class="sec-title">{{ manifeste.titre }}</h1>
          <p class="mf-sub">{{ manifeste.sous_titre }}</p>
        </div>
        <span class="sec-tag">MANIFESTE</span>
      </div>

      {% for section in manifeste.sections %}
      <div class="mf-section">
        <h2>{{ section.titre }}</h2>
        <div>{{ section.contenu | markdownBlock }}</div>
      </div>
      {% endfor %}
    </div>
  </section>

  <footer class="mf-footer">
    <a href="/">← Retour sur le site</a>
  </footer>
</body>
</html>
